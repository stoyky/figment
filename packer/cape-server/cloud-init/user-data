  codecs:
    install: true
  drivers:
    install: true
  kernel:
    package: linux-generic-hwe-24.04
  keyboard:
    layout: us
    variant: ''
  locale: en_US.UTF-8
  network:
    version: 2
    ethernets:
        ens33:
            match:
                name: "en*"
            dhcp4: true
        eth1:
            match:
                name: "eth*"
            dhcp4: true
  oem:
    install: auto
  source:
    id: ubuntu-desktop-minimal
#    id: ubuntu-desktop
    search_drivers: true
  ssh:
   allow-pw: true
   authorized-keys: []
   install-server: true
  storage:
    grub:
      reorder_uefi: false
    layout:
      name: lvm
      sizing-policy: all
  identity:
    realname: ''
    hostname: cape-server
    username: ubuntu
    # openssl passwd -6 -salt "$(openssl rand -hex 8)" 'password'
    password: '$6$2723c7281b2fa96a$zI5lptnAkuRMPJepiXLLCkrmfTRbv6Oal2q.rx.AIeOwhH6KFDR.CpyPduUIj/IdFjhScJo9fpK73X1iG2xGk/'
  timezone: Europe/Amsterdam
  updates: security
  version: 1
  late-commands:
    - "curtin in-target --target=/target -- bash -c 'echo \"ubuntu ALL=(ALL) NOPASSWD:ALL\" > /etc/sudoers.d/ubuntu'"
    - "curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/ubuntu"